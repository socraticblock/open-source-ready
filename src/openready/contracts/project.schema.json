{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-ready/project.schema.json",
  "title": "Open-Ready new-project private policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "visibility",
    "risk_tier",
    "openready_version",
    "data_ref",
    "languages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "visibility": {
      "const": "PRIVATE"
    },
    "openready_version": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "data_ref": {
      "type": "string",
      "description": "Logical private data ID; NOT an absolute path",
      "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license_intent": {
      "enum": [
        "UNDECIDED",
        "CANDIDATE_SELECTED",
        "RELEASE_LICENSED"
      ],
      "default": "UNDECIDED"
    },
    "checks_profile_version": {
      "type": "string"
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "private_overlays": {
      "type": "boolean",
      "default": true
    }
  }
}
